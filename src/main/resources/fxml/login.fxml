<?xml version="1.0" encoding="UTF-8"?>

<?import gui.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<GridPane xmlns="http://javafx.com/javafx/" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.LoginController">
   <columnConstraints>
      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="20.0" prefWidth="100.0" />
      <ColumnConstraints hgrow="SOMETIMES" minWidth="30.0" percentWidth="60.0" />
      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="20.0" prefWidth="100.0" />
   </columnConstraints>
   <rowConstraints>
      <RowConstraints minHeight="10.0" percentHeight="20.0" prefHeight="30.0" vgrow="ALWAYS" />
      <RowConstraints minHeight="30.0" percentHeight="60.0" vgrow="SOMETIMES" />
      <RowConstraints minHeight="10.0" percentHeight="20.0" prefHeight="30.0" vgrow="ALWAYS" />
   </rowConstraints>
   <children>
       <PingBox fx:id="pingBox" alignment="TOP_RIGHT" maxHeight="20" GridPane.columnIndex="2" GridPane.halignment="RIGHT" GridPane.hgrow="ALWAYS" GridPane.valignment="TOP" GridPane.vgrow="ALWAYS">
         <GridPane.margin>
            <Insets right="10.0" top="10.0" />
         </GridPane.margin>
       </PingBox>
       <ImageView fitWidth="120.0" pickOnBounds="true" preserveRatio="true" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.hgrow="ALWAYS" GridPane.valignment="CENTER" GridPane.vgrow="ALWAYS" StackPane.alignment="CENTER">
           <GridPane.margin>
               <Insets left="20.0" right="20.0" top="20.0" />
           </GridPane.margin>
           <viewport>
               <Rectangle2D />
           </viewport>
           <Image url="@../images/intro.png" />
       </ImageView>
      <VBox alignment="CENTER" spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="1">
          <Label maxWidth="1.7976931348623157E308" text="Username" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" />
          <TextField fx:id="usernameField" promptText="Enter your username" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" />
          <Button defaultButton="true" maxWidth="1.7976931348623157E308" onAction="#handleLogin" text="Join" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
            <VBox.margin>
               <Insets top="10.0" />
            </VBox.margin></Button>
         <padding>
            <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
         </padding>
      </VBox>
   </children>
</GridPane>
