<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<GridPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.ChangeUsernameController">
    <columnConstraints>
        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="20.0" prefWidth="100.0" />
        <ColumnConstraints hgrow="SOMETIMES" minWidth="30.0" percentWidth="60.0" />
        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="20.0" prefWidth="100.0" />
    </columnConstraints>
    <rowConstraints>
        <RowConstraints minHeight="10.0" percentHeight="20.0" prefHeight="30.0" vgrow="SOMETIMES" />
        <RowConstraints minHeight="30.0" percentHeight="60.0" vgrow="SOMETIMES" />
        <RowConstraints minHeight="10.0" percentHeight="20.0" prefHeight="30.0" vgrow="SOMETIMES" />
    </rowConstraints>
    <children>
        <ImageView fitWidth="120.0" pickOnBounds="true" preserveRatio="true" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.hgrow="ALWAYS" GridPane.valignment="CENTER" GridPane.vgrow="ALWAYS" StackPane.alignment="CENTER">
            <GridPane.margin>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </GridPane.margin>
            <viewport>
                <Rectangle2D />
            </viewport>
            <Image url="@../images/intro.png" />
        </ImageView>
      <DialogPane fx:id="dialogPane" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1" GridPane.valignment="CENTER" GridPane.vgrow="ALWAYS">
         <buttonTypes>
            <ButtonType fx:id="applyButton" fx:constant="APPLY" />
            <ButtonType fx:id="cancelButton" fx:constant="CANCEL" />
         </buttonTypes>
         <content>
              <VBox alignment="CENTER" spacing="10">
                  <Label maxWidth="1.7976931348623157E308" text="Username" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" />
                  <TextField fx:id="usernameField" promptText="Change your username" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" />
                  <padding>
                      <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                  </padding>
              </VBox>
         </content>
      </DialogPane>
    </children>
</GridPane>
